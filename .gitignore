# Arquivos gerados por scripts/gerar-paginas.js (o workflow de publicação recria todos)
/prova-*.html
/trabalho-*.html
/404.html
/sitemap.xml
/robots.txt

# Cloudflare (estado local do wrangler)
/.wrangler/
/.dev.vars

# Dependências (npm install)
/node_modules/

# Pasta que o deploy sobe (scripts/montar-publico.mjs)
/publico/

# Painel (React): gerado por npm run painel:build a partir de painel/ (painel/vite.config.mts)
/admin.html
/admin-novo.html
/assets/painel/
/painel/dist/
