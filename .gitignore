/dist/
/.astro/
# Pasta que o wrangler serve (testes, dev) e que o deploy sobe
/publico/

# Cloudflare (estado local do wrangler)
/.wrangler/
/.dev.vars

# Dependências (npm install)
/node_modules/

# Painel (React): gerado por npm run painel:build a partir de painel/ (painel/vite.config.mts)
/admin.html
/admin-novo.html
/assets/painel/
/painel/dist/
