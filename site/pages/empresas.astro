---
import Pagina from "../layouts/Pagina.astro";
import Topo from "../components/Topo.astro";
import Rodape from "../components/Rodape.astro";
import WhatsFlutuante from "../components/WhatsFlutuante.astro";

const SCRIPTS = ["js/menu.js","js/eventos.js","js/provas-db.js","js/orcamento.js","js/monte.js","js/ui.js"];
---
<Pagina
  titulo="Para empresas · Tardim Produções"
  descricao="Corridas de rua, corridas corporativas, eventos, locação de estrutura e prevenção contra incêndio para empresas, órgãos públicos e instituições em Minas Gerais. Simule sua corrida e peça um orçamento."
  og={{ titulo: "Para empresas · Tardim Produções", descricao: "Sua corrida ou evento do começo ao fim, com um só fornecedor. Simule e peça seu orçamento.", caminho: "empresas.html" }}
  icones
  scripts={SCRIPTS}
>
    <Topo atual="empresas" cta="#orcamento" />

    <main id="conteudo">
      <!-- Abertura da página de quem contrata -->
      <section class="emp-hero">
        <div class="wrap">
          <nav class="emp-hero__crumb" aria-label="Você está em"><a href="index.html">Início</a> <span aria-hidden="true">›</span> <span aria-current="page">Para empresas</span></nav>
          <p class="eyebrow">Para empresas, órgãos públicos e instituições</p>
          <h1>Sua corrida ou evento, <span>do começo ao fim.</span></h1>
          <p class="emp-hero__lead">Planejamento, licenças, prevenção contra incêndio, estrutura e equipe no dia. Um só fornecedor, da primeira conversa à linha de chegada.</p>
          <div class="actions">
            <a class="btn btn--red btn--lg" href="#orcamento">Pedir orçamento</a>
            <a class="btn btn--white btn--lg" href="#monte">Simular minha corrida</a>
          </div>
          <p class="emp-hero__prova"><a href="portfolio.html">Veja o portfólio</a> com mais de 60 corridas organizadas, ou a <a href="institucional.html">página institucional</a> para órgãos públicos e conselhos.</p>
        </div>
      </section>

      <!-- Serviços (bento) + ofertas para empresas -->
      <section class="block" id="servicos">
        <div class="wrap">
          <div class="block__head">
            <h2>Serviços</h2>
            <p>Tudo o que um evento precisa para sair do papel com segurança, em um só fornecedor.</p>
          </div>
          <div class="bento">
            <article class="bento__item bento__item--hero">
              <img src="assets/fotos/hulk-run-largada.webp" alt="" loading="lazy" width="399" height="462" />
              <div class="bento__content">
                <span class="bento__icon"><svg aria-hidden="true"><use href="#i-run" /></svg></span>
                <h3>Eventos esportivos</h3>
                <p>A corrida inteira, do planejamento à premiação: corridas de rua, caminhadas e provas kids.</p>
                <a class="bento__link" href="#como-funciona">Veja como funciona ↓</a>
              </div>
            </article>
            <article class="bento__item bento__item--fire">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-fire" /></svg></span>
              <div>
                <h3>Prevenção contra incêndio</h3>
                <p>Projetos e instalação de sistemas de prevenção, brigada de incêndio com bombeiros civis e controle de pânico.</p>
              </div>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-doc" /></svg></span>
              <h3>Regularização e licenciamento</h3>
              <p>Alvarás, autorizações e operação de trânsito.</p>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-store" /></svg></span>
              <h3>Feiras, congressos e festas</h3>
              <p>Organização completa de feiras, exposições e eventos corporativos, com locação de estrutura.</p>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-gear" /></svg></span>
              <h3>Engenharia</h3>
              <p>Serviços de engenharia para estruturas e projetos.</p>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-team" /></svg></span>
              <h3>Staff para eventos</h3>
              <p>Seleção e agenciamento de equipe para o dia do evento.</p>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-chart" /></svg></span>
              <h3>Consultoria</h3>
              <p>Gestão e planejamento de eventos.</p>
            </article>
            <article class="bento__item">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-mega" /></svg></span>
              <h3>Divulgação</h3>
              <p>Artes, redes sociais e comunicação com os inscritos.</p>
            </article>
            <article class="bento__item bento__item--wide">
              <span class="bento__icon"><svg aria-hidden="true"><use href="#i-tent" /></svg></span>
              <div>
                <h3>Locação de estrutura</h3>
                <p>Tudo para o seu evento, seja corrida, feira, congresso ou festa: tendas, gradis, pórtico de largada e chegada, sinalização de percurso e o que mais o evento precisar.</p>
              </div>
              <a class="btn btn--red btn--sm" href="#orcamento" data-orc="estrutura">Pedir orçamento de estrutura</a>
            </article>
          </div>

          <div class="servicos__empresas" id="empresas">
            <h3 class="servicos__sub">Para empresas</h3>
            <p class="muted">Corridas com a sua marca, produzidas de ponta a ponta pela Tardim Produções.</p>
            <div class="offers">
              <article>
                <h3>Corrida da sua marca</h3>
                <p>
                  Uma prova com o nome da sua empresa, aberta ao público. Cuidamos do percurso,
                  licenças, kit, arena, premiação e divulgação, como fizemos na Hulk Run.
                </p>
              </article>
              <article>
                <h3>Corrida corporativa</h3>
                <p>
                  Evento para funcionários e clientes: aniversário da empresa, ações de saúde e
                  bem-estar, integração de equipes. Caminhada, 5 km, 10 km ou kids.
                </p>
              </article>
              <article>
                <h3>Patrocínio de provas</h3>
                <p>
                  Coloque sua marca nas corridas do nosso calendário: kit do atleta, pórtico, arena,
                  ativações no dia e divulgação nas redes.
                </p>
              </article>
            </div>
            <a class="btn btn--red" href="#orcamento" data-orc="corporativa" data-contratante="Empresa privada">Pedir orçamento para minha empresa</a>
          </div>
        </div>
      </section>

      <!-- Corrida do começo ao fim -->
      <section class="block steps-sec" id="como-funciona">
        <div class="wrap">
          <div class="block__head">
            <h2>Sua corrida do começo ao fim</h2>
            <p>Você define o objetivo. A Tardim Produções cuida de todo o resto.</p>
          </div>
          <ol class="steps">
            <li>
              <h3>Planejamento</h3>
              <p>Data, local, percursos, público e orçamento definidos com você.</p>
            </li>
            <li>
              <h3>Licenças e chancela</h3>
              <p>Alvarás, autorizações da prefeitura e do trânsito, prevenção contra incêndio e chancela da Federação Mineira de Atletismo.</p>
            </li>
            <li>
              <h3>Inscrições e kits</h3>
              <p>Plataforma de inscrição, camisetas, números de peito, medalhas e retirada de kit.</p>
            </li>
            <li>
              <h3>Divulgação</h3>
              <p>Artes da prova, redes sociais e comunicação com os inscritos.</p>
            </li>
            <li>
              <h3>Dia da prova</h3>
              <p>Arena, largada e chegada, staff, brigada de incêndio, hidratação, cronometragem, premiação e shows.</p>
            </li>
            <li>
              <h3>Pós-prova</h3>
              <p>Resultados, fotos e desmontagem de toda a estrutura.</p>
            </li>
          </ol>
          <div class="steps__cta">
            <p><strong>Um só fornecedor, do primeiro contato à linha de chegada.</strong> Você não precisa contratar mais ninguém.</p>
            <a class="btn btn--red btn--lg" href="#orcamento" data-orc="corrida">Quero organizar uma corrida</a>
          </div>
        </div>
      </section>

      <!-- Simulador: monte sua corrida -->
      <section class="block monte-sec" id="monte">
        <div class="wrap">
          <div class="block__head">
            <p class="eyebrow">Passo 1 · Simule</p>
            <h2>Monte sua corrida</h2>
            <p>Escolha como você imagina a prova e veja tudo o que a Tardim Produções cuida para ela acontecer.</p>
          </div>
          <div class="monte" id="monte-app"></div>
        </div>
      </section>

      <!-- Pedido de orçamento guiado: monta a mensagem e abre no WhatsApp -->
      <section class="block orc-sec" id="orcamento">
        <div class="wrap orc">
          <div class="orc__intro">
            <p class="eyebrow">Passo 2 · Orçamento</p>
            <h2>Peça seu orçamento</h2>
            <p>Conte o básico sobre o evento. A mensagem chega pronta no WhatsApp da Tardim Produções, sem precisar explicar tudo de novo.</p>
            <ul class="orc__points">
              <li>Atendimento direto com a equipe que organiza</li>
              <li>Proposta para empresas, órgãos públicos e instituições</li>
              <li>Da corrida completa a um serviço específico</li>
            </ul>
            <!-- Depoimentos do painel (aba Depoimentos): só aparece quando há algum publicado -->
            <div class="orc__depo" data-depoimentos="empresas" data-max="2" hidden></div>
          </div>
          <form class="orc__form" id="orc-form" novalidate>
            <!-- Duas etapas (js/orcamento.js): 1 = sobre o evento, 2 = sobre você. Sem JavaScript, aparece tudo de uma vez. -->
            <p class="orc__passo orc__field--full" id="orc-passo" hidden></p>
            <fieldset class="orc__field orc__field--full" data-etapa="1">
              <legend>O que você precisa? <span class="req" aria-hidden="true">*</span></legend>
              <div class="orc__chips" id="orc-servico"></div>
              <p class="orc__erro" id="orc-servico-erro" hidden>Escolha uma opção.</p>
            </fieldset>
            <label class="orc__field" data-etapa="1">
              <span>Cidade do evento <span class="req" aria-hidden="true">*</span></span>
              <input name="cidade" autocomplete="address-level2" required />
              <span class="orc__erro" hidden>Informe a cidade.</span>
            </label>
            <div class="orc__field" data-etapa="1">
              <span id="orc-data-rotulo">Data prevista</span>
              <div class="orc__pair" role="group" aria-labelledby="orc-data-rotulo">
                <select name="mes" aria-label="Mês"></select>
                <select name="ano" aria-label="Ano"></select>
              </div>
            </div>
            <label class="orc__field" data-etapa="1">
              <span>Público estimado</span>
              <select name="publico">
                <option value="">Ainda não sei</option>
                <option>Até 300 pessoas</option>
                <option>300 a 1.000 pessoas</option>
                <option>1.000 a 3.000 pessoas</option>
                <option>3.000 a 5.000 pessoas</option>
                <option>Mais de 5.000 pessoas</option>
              </select>
            </label>
            <div class="orc__acoes orc__field--full" data-etapa="1" id="orc-avancar-box" hidden>
              <button type="button" class="btn btn--red btn--lg" id="orc-avancar">Continuar</button>
            </div>
            <label class="orc__field" data-etapa="2">
              <span>Seu nome <span class="req" aria-hidden="true">*</span></span>
              <input name="nome" autocomplete="name" required />
              <span class="orc__erro" hidden>Informe seu nome.</span>
            </label>
            <label class="orc__field" data-etapa="2">
              <span>Empresa ou instituição</span>
              <input name="empresa" autocomplete="organization" />
            </label>
            <label class="orc__field" data-etapa="2">
              <span>Quem contrata</span>
              <select name="contratante">
                <option value="">Selecione</option>
                <option>Empresa privada</option>
                <option>Órgão público ou conselho</option>
                <option>Associação, clube ou instituição</option>
                <option>Pessoa física</option>
              </select>
            </label>
            <label class="orc__field orc__field--full" data-etapa="2">
              <span>Conte um pouco mais <small>(opcional)</small></span>
              <textarea name="detalhes" rows="3" placeholder="Percursos, local, kit, o que já está definido…"></textarea>
            </label>
            <div class="orc__acoes orc__field--full" data-etapa="2">
              <button type="submit" class="btn btn--wa btn--lg">
                <svg aria-hidden="true"><use href="#i-whatsapp" /></svg>
                Enviar pelo WhatsApp
              </button>
              <button type="button" class="orc__email" id="orc-email">Prefiro enviar por e-mail</button>
              <button type="button" class="orc__email" id="orc-voltar" hidden>← Voltar</button>
            </div>
            <p class="orc__ok orc__field--full" id="orc-ok" role="status" hidden></p>
            <p class="orc__nota orc__field--full">Enquanto você preenche, nada é enviado. Ao enviar, a mensagem abre no seu aplicativo e uma cópia do pedido fica guardada com a Tardim Produções, só para o atendimento. <a href="privacidade.html">Política de privacidade</a>.</p>
          </form>
        </div>
      </section>

    </main>

    <Rodape linktree />

    <WhatsFlutuante mensagem="Olá! Vim pela página de empresas do site da Tardim Produções." naUrl />
</Pagina>
